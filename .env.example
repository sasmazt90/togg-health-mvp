# ==============================================================================
# TOGG HEALTH MVP - ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# Bu dosya şablondur. Gerçek anahtarları ASLA bu dosyaya yazmayın.
# ==============================================================================

# Uygulama Ayarları
APP_ENV=development
APP_NAME=togg-health-mvp
PORT=3000
API_PORT=8000

# Frontend (Next.js) Yapılandırması
NEXT_PUBLIC_APP_NAME="Togg Health MVP"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_DEMO_MODE=true

# Araç Bağlamı (Vehicle Context)
VEHICLE_SIMULATOR_ENABLED=true
DEFAULT_VEHICLE_STATE="PARKED" # PARKED | DRIVING

# Local Storage / Veritabanı
SQLITE_DB_PATH="./data/togg_health_local.db"

# İsteğe Bağlı AI / LLM / TTS Servisleri (Yerel Fallback mevcuttur)
# OPENAI_API_KEY=sk-demo-placeholder-only
# ELEVENLABS_API_KEY=demo-placeholder-only
